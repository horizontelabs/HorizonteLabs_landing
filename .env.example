# Configuración de entorno para sustrato.ai

# Dominio canónico de producción (sin slash final)
VITE_SITE_URL="https://sustratolab.vercel.app"

# Correo de contacto visible y fallback directo en caso de contingencia
VITE_CONTACT_EMAIL="contacto@sustrato.ai"

# Opcional: URL de agenda directa (Cal.com o Calendly) para mostrar enlace alternativo
VITE_BOOKING_URL=""

# Backend de diagnóstico (Vercel Serverless Function /api/contact)
# Opción 1: Envío de correos con Resend (https://resend.com)
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Sustrato <no-reply@sustrato.ai>"
CONTACT_TO_EMAIL="contacto@sustrato.ai"

# Opción 2: Webhook directo (Slack, Notion, n8n, Zapier o CRM propio)
CONTACT_WEBHOOK_URL=""
